{
  "manifest_version": 3,
  "name": "BLACK PANTHER — SLOT AUTOMATION",
  "version": "2.3.0",
  "description": "Adaptive appointment workflow panel with event-driven OTP delivery and paced retries.",
  "minimum_chrome_version": "109",
  "permissions": ["storage"],
  "optional_host_permissions": ["https://*/*"],
  "options_page": "options.html",
  "host_permissions": [
    "https://appointment.ivacbd.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open BLACK PANTHER — SLOT AUTOMATION"
  },
  "content_scripts": [
    {
      "matches": ["https://appointment.ivacbd.com/*"],
      "css": ["black-panther.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
