{
  "manifest_version": 3,
  "name": "Visa Automator Pro",
  "version": "2.2.0",
  "description": "Adaptive appointment workflow with event-driven phone OTP delivery and paced retries.",
  "minimum_chrome_version": "109",
  "permissions": ["storage"],
  "optional_host_permissions": ["https://*/*"],
  "options_page": "options.html",
  "host_permissions": [
    "https://appointment.ivacbd.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Visa Automator Pro"
  },
  "content_scripts": [
    {
      "matches": ["https://appointment.ivacbd.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
